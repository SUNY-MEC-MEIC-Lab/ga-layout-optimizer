{
  "_note": "가상 SMR 보조건물 — 계단·승강기 코어를 고정에서 풀되 층마다 같은 자리(수직 코어)로 묶고, 복도 구간은 필요한 만큼만 남긴다. 기기는 유지보수를 위해 복도에서 접근 가능해야 한다. 외곽 크기 한도(현재 도면 크기)는 두지 않는다 — 목표는 전체 면적을 줄이는 것이다(소유자 확인 2026-11-02).",
  "_sources": {
    "IBC": "IBC 2021 §1006.3, §1007.1.1, Table 1020.3 (UpCodes 무수정 주 채택본)",
    "10 CFR 50 App.R": "III.G.2 계열 분리(기존 요건에 이미 반영), III.J 비상조명 — 피난로 존재가 전제"
  },
  "program": {
    "circulation": [
      {
        "match": "^CORE-",
        "type": "stair",
        "unpin": true
      }
    ],
    "stack_cores": true,
    "optional_corridors": true
  },
  "set": {
    "constraints": [
      {
        "id": "CIRC-ACCESS",
        "params": {
          "door_m": 1.2,
          "via_rooms": 0,
          "touch_tol_m": 0.5,
          "applies_to": [
            "equipment",
            "room"
          ],
          "no_entry_types": [
            "stair",
            "elevator"
          ]
        },
        "_why": "기기 정비·반출을 위해 복도에 1.2 m 이상 접해야 한다 (가정값 — IAEA SSR-2/1 Req.29 정비 접근성은 정성 요건) · 기기실 문은 피난계단실·승강기로 내지 않는다 — 계단실 개구부는 평상시 재실 공간의 출입용으로 제한 (IBC 2021 §1023.4, 조사 R1)"
      },
      {
        "id": "CIRC-CONNECT",
        "params": {
          "min_width_m": 1.118,
          "touch_tol_m": 0.5,
          "must_include": [
            "stair"
          ]
        },
        "_why": "IBC Table 1020.3 복도 44 in 로 이어져 계단에 닿아야 한다"
      },
      {
        "id": "EGRESS",
        "params": {
          "max_travel_m": 76.2,
          "min_exits": 2,
          "exit_separation_frac": 0.333
        },
        "_why": "층당 2개 출구 IBC §1006.3, 대각선 1/3 §1007.1.1, 보행거리 250 ft = Table 1017.2 F-1 스프링클러 (독립 검증에서 확인). 위층 계단은 1층까지 이어져야 한다"
      },
      {
        "id": "DEAD-END",
        "params": {
          "max_m": 15.24,
          "min_width_m": 1.118,
          "touch_tol_m": 0.5
        },
        "_why": "막다른 복도 50 ft(15.24 m) 이하 — 복도 구간을 없애다 막다른 복도가 길어지지 않게 (IBC 2021 §1020.5, 스프링클러, 조사 R15)"
      },
      {
        "id": "ADJACENT",
        "params": {
          "rules": [
            {
              "a": "^HATCH",
              "b": "circ:corridor",
              "mode": "must",
              "min_touch_m": 4.0,
              "why": "기기반출 해치는 복도에 맞닿아 기기를 옮겨 낼 수 있어야 한다 (IAEA SSG-90 5.19(h); 4 m 는 가정)"
            }
          ],
          "touch_tol_m": 0.5
        },
        "_why": "기기반출 해치 ↔ 복도 (조사 R13 — 접면 4 m 는 가정값)"
      }
    ],
    "weights": {
      "sep": 100000.0,
      "exterior": 100000.0,
      "envelope": 100000.0,
      "crane": 100000.0,
      "fixed": 100000.0,
      "elev": 100000.0,
      "constraint.CIRC-ACCESS": 100000.0,
      "constraint.CIRC-CONNECT": 100000.0,
      "constraint.EGRESS": 100000.0,
      "constraint.DEAD-END": 100000.0,
      "constraint.ADJACENT": 100000.0
    },
    "max_w": null,
    "max_d": null
  },
